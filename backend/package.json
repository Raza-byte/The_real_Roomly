{
    "name": "roomly-backend",
    "version": "1.0.0",
    "description": "Interior Design App - Sprint 1 Backend",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev":   "nodemon server.js",
        "test":              "jest --runInBand --forceExit",
        "test:watch":        "jest --watch --runInBand",
        "test:coverage":     "jest --coverage --runInBand --forceExit",
        "test:us1":          "jest tests/auth.test.js        --runInBand --forceExit --verbose",
        "test:us2":          "jest tests/design.test.js      --runInBand --forceExit --verbose",
        "test:us3":          "jest tests/export.test.js --runInBand --forceExit --verbose",
        "test:integration": "jest tests/integration.test.js --runInBand --forceExit --verbose"
    },
    "jest": {
        "testEnvironment": "node",
        "testTimeout": 30000,
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "verbose": true
    },
    "dependencies": {
        "bcryptjs":           "^2.4.3",
        "cors":               "^2.8.5",
        "dotenv":             "^16.3.1",
        "express":            "^4.18.2",
        "express-validator":  "^7.0.1",
        "jsonwebtoken":       "^9.0.2",
        "mongoose":           "^8.0.3"
    },
    "devDependencies": {
        "jest":                   "^29.7.0",
        "mongodb-memory-server":  "^9.1.6",
        "nodemon":                "^3.0.2",
        "supertest":              "^6.3.4"
    }
}
